# Generated from .env.schema and apps/api/.env.schema by `pnpm env:example`.
# Copy to .env.local and fill in only what you need. Every value is optional
# except where its note says otherwise. Never commit .env.local.

# .env.schema

APP_ENV=

# Alchemy profile used for deploys. Set it explicitly; credentials stay in the profile.
ALCHEMY_PROFILE=

# Alchemy credential directory. CI preview uses a disposable private runner directory.
ALCHEMY_HOME=

# Cloudflare credentials for `pnpm self-host` only, as an alternative to ALCHEMY_PROFILE.
# When the account id and a token or key are all set, they override the profile.
# Repository deploys use a profile locally and CI secrets in CI.
CLOUDFLARE_ACCOUNT_ID=

CLOUDFLARE_API_TOKEN=

CLOUDFLARE_API_KEY=

# Preview CI inputs; mapped to the isolated profile and Worker only by its workflow.
PREVIEW_BETTER_AUTH_SECRET=

PREVIEW_STRIPE_TEST_API_KEY=

# Turbo sets this only inside a task.
TURBO_HASH=

# apps/api/.env.schema

# Feeds fetched per cron run. A feed costs one fetch, a SmartRecruiters board
# up to five pages. Every fetch can retry twice on transient errors, and each
# redirect hop counts as a subrequest too.
# Workers Free allows 50 subrequests per invocation; Workers Paid allows far more.
INGEST_FEEDS_PER_RUN=

# Feeds fetched at the same time within one run.
INGEST_FEED_CONCURRENCY=

# Workers AI model that extracts listing details. Defaults to @cf/meta/llama-3.3-70b-instruct-fp8-fast.
# Point a live lane at a model that does not exist to rehearse Workers AI failing.
ENRICHMENT_MODEL=

# Most listings each cron run queues for enrichment: 72 runs a day at 8 is 576.
# Unset, it is 8 on the prod stage and 0 on every other stage, so a verify
# stage left running makes no model calls. Set it to enrich on a verify stage.
ENRICHMENT_SWEEP_LIMIT=

# Most Workers AI neurons per UTC day. Each call claims its worst-case cost in
# D1 before it runs, and queue retries claim again; after the call the claim is
# lowered to the neurons Workers AI reports. Defaults to 29000, which keeps a
# 31-day month under $10 at $0.011 per 1,000 neurons even with no free neurons.
# The persistent preview stage defaults to 0, including queue deliveries.
ENRICHMENT_DAILY_NEURONS=

# How far back, in hours, each cron run looks for company-board listings that
# are still unenriched. Defaults to 24.
ENRICHMENT_SWEEP_HOURS=

# Signs better-auth session cookies. At least 32 characters. The deploy fails without it.
BETTER_AUTH_SECRET=

# GitHub OAuth app for "Continue with GitHub". Leave both empty to hide the button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client for "Continue with Google". Leave both empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated extra hosts better-auth accepts on a non-prod stage, such as localhost:* for alchemy dev. The prod stage ignores it.
AUTH_EXTRA_HOSTS=

# Sign-in sends admitted before a 24-hour quiet period resets the budget.
# Default900 plus50 digest sends leaves50 of the observed1000/day quota unused.
# The persistent preview stage defaults to 10; these are separate D1 budgets.
# Recheck the account quota before changing this or any other sending stage.
MAGIC_LINK_DAILY_SEND_LIMIT=

# Saved-search digests sent per hourly digest run. Each send is one Email Sending call.
# Defaults to 25, or 1 on the persistent preview stage.
DIGEST_SENDS_PER_RUN=

# Digests sent in any rolling 24 hours, across runs. Keep it under the account's
# Email Sending daily quota with room left for sign-in links, which share it.
# Defaults to 50, or 5 on the persistent preview stage.
DIGEST_DAILY_SEND_LIMIT=

# Version signed into unsubscribe links. Change it to revoke old links without
# rotating the authentication secret or ending sessions.
UNSUBSCRIBE_TOKEN_VERSION=

# Origin for job and unsubscribe links in digests. Defaults to https://jobs.rowlandekemezie.com,
# or https://jobs-preview.rowland-ekemezie.workers.dev on the persistent preview stage.
DIGEST_SITE_ORIGIN=

# Sell Pro on this stage. Declares the Stripe Product, Prices, billing portal
# configuration and webhook endpoint, so the Alchemy profile needs a Stripe key.
# On by default only for the persistent preview stage, off elsewhere.
# Other non-prod stages also need WORKERS_SUBDOMAIN for their webhook URL.
BILLING_ENABLED=

# Pro plans as a JSON array. Each entry declares one Stripe Price on deploy.
# Pro sells one plan, $5 a week:
# [{"plan":"Weekly","amountCents":500,"interval":"week"}]
# plan is a capitalized name, also shown on the pricing page. interval is day,
# week, month or year; intervalCount defaults to 1. Unknown keys are refused.
# onSale false archives the price and hides it from checkout, while existing
# subscribers renew on it and keep Pro. Never drop or reprice a plan that has
# subscribers. Add a new plan name and set the old one's onSale to false.
# Empty means no plans, which hides billing even with BILLING_ENABLED.
PRO_PLANS=

# Stripe restricted key the Worker uses for Checkout, customers and the billing
# portal. Create it in the Stripe Dashboard with Checkout Sessions, Customers and
# Customer portal write only. The prod deploy refuses BILLING_ENABLED without an
# rk_live_ key here. Other stages accept only test keys and fall back to the
# Alchemy profile's test key when it is empty.
STRIPE_RESTRICTED_KEY=

# The account's workers.dev subdomain, as in jobs-<stage>.<subdomain>.workers.dev. The build bakes it into both Workers and the browser bundle as the site's own host, so job links to it are dropped. Unset, the build uses the owner's subdomain (OWNER_WORKERS_SUBDOMAIN in packages/core/src/site.ts) and the persistent preview defaults to it; other non-prod stages trust no workers.dev host without it. Prod trusts only its custom domain.
WORKERS_SUBDOMAIN=

# Shared secret for the website to reach its native PR backend preview.
# Required on pr-N stages; requests fail closed if fewer than 32 characters.
PR_PREVIEW_SECRET=
