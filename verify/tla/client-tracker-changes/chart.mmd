stateDiagram-v2
  state "Legend" as legend {
    lg0: saving
    lg1: settled
    lg2: wrong
    lg3: Breaks FailureIsAnnounced or SettledCardMatchesServer
    lg4: Path to the FailureIsAnnounced or SettledCardMatchesServer bug
