stateDiagram-v2
  state "Legend" as legend {
    lg0: in
    lg1: out
    lg2: start
    lg3: Breaks BrowserListShown or MovingOnlyWhileMoving or NoBrowserJobLost
    lg4: Path to the BrowserListShown or MovingOnlyWhileMoving or NoBrowserJobLost bug
