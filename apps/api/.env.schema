# Environment for the JobsBackend Worker. Checked in; no values here.
# @defaultRequired=false
# @defaultSensitive=false
# ---

# Feeds fetched per cron run. A feed costs one fetch, a SmartRecruiters board
# up to five pages. Every fetch can retry twice on transient errors, and each
# redirect hop counts as a subrequest too.
# Workers Free allows 50 subrequests per invocation; Workers Paid allows far more.
# @type=number
INGEST_FEEDS_PER_RUN=

# Feeds fetched at the same time within one run.
# @type=number
INGEST_FEED_CONCURRENCY=

# Signs better-auth session cookies. At least 32 characters. The deploy fails without it.
# @sensitive
BETTER_AUTH_SECRET=

# GitHub OAuth app for "Continue with GitHub". Leave both empty to hide the button.
GITHUB_CLIENT_ID=
# @sensitive
GITHUB_CLIENT_SECRET=

# Google OAuth client for "Continue with Google". Leave both empty to hide the button.
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=

# Comma-separated extra hosts better-auth accepts on a non-prod stage, such as localhost:* for alchemy dev. The prod stage ignores it.
AUTH_EXTRA_HOSTS=

# The account's workers.dev subdomain, as in jobs-<stage>.<subdomain>.workers.dev. A non-prod stage trusts no workers.dev host without it. The prod stage ignores it.
WORKERS_SUBDOMAIN=
