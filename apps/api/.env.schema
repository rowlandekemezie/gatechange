# Environment for the JobsBackend Worker. Checked in; no values here.
# @defaultRequired=false
# @defaultSensitive=false
# ---

# Feeds fetched per cron run. A feed costs one fetch, a SmartRecruiters board
# up to five pages. Every fetch can retry twice on transient errors, and each
# redirect hop counts as a subrequest too.
# Workers Free allows 50 subrequests per invocation; Workers Paid allows far more.
# @type=number
INGEST_FEEDS_PER_RUN=

# Feeds fetched at the same time within one run.
# @type=number
INGEST_FEED_CONCURRENCY=

# Workers AI model that extracts listing details. Defaults to @cf/meta/llama-3.3-70b-instruct-fp8-fast.
# Point a live lane at a model that does not exist to rehearse Workers AI failing.
ENRICHMENT_MODEL=

# Most listings each cron run queues for enrichment. This caps Workers AI spend:
# 72 runs a day at the default 10 is at most 720 model calls a day.
# @type=number
ENRICHMENT_SWEEP_LIMIT=

# How far back, in hours, each cron run looks for company-board listings that
# are still unenriched. Defaults to 24.
# @type=number
ENRICHMENT_SWEEP_HOURS=
