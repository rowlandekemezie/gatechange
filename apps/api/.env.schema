# Environment for the JobsBackend Worker. Checked in; no values here.
# @defaultRequired=false
# @defaultSensitive=false
# ---

# Feeds fetched per cron run. Each feed costs up to three subrequests (fetch,
# upsert batch, replace batch) and every run adds three more.
# Workers Free allows 50 subrequests per invocation, so stay at 15 or fewer there;
# 15 refreshes about 275 company boards every six hours, 24 refreshes 400+ on Workers Paid.
# @type=number
INGEST_FEEDS_PER_RUN=

# Feeds fetched at the same time within one run.
# @type=number
INGEST_FEED_CONCURRENCY=
