{
  "name": "job-board",
  "version": "0.1.0",
  "private": true,
  "description": "Engineering leadership job board on rat-stack: Effect 4, Alchemy on Cloudflare Workers and D1, and a Foldkit UI.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rat-stack/infra run dev",
    "alchemy": "pnpm --filter @rat-stack/infra exec alchemy",
    "build": "turbo run build",
    "check": "pnpm run lockfile:check && varlock load && turbo run typecheck && ultracite check && oxfmt --check .",
    "env:check": "varlock load",
    "env:example": "node scripts/env-example.ts",
    "env:example-check": "node scripts/env-example.ts --check",
    "fix": "ultracite fix && oxfmt .",
    "lint": "ultracite check && oxfmt --check .",
    "lockfile:check": "pnpm --config.optimistic-repeat-install=false install --frozen-lockfile --offline --lockfile-only --ignore-scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "infra:deploy": "turbo run build --filter=@rat-stack/infra... && pnpm --filter @rat-stack/infra run deploy",
    "infra:destroy": "pnpm --filter @rat-stack/infra run destroy",
    "infra:plan": "turbo run build --filter=@rat-stack/infra... && pnpm --filter @rat-stack/infra run plan",
    "prepare": "effect-tsgo patch && if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typecheck-scripts": "tsc --noEmit -p tsconfig.json",
    "vendor:agent-sources": "./scripts/vendor-agent-sources.sh",
    "self-host": "turbo run build --filter=@rat-stack/infra... && node apps/infra/src/self-host.ts",
    "ingest:logs": "pnpm --filter @rat-stack/infra run logs",
    "infra:ci-credentials": "pnpm --filter @rat-stack/infra exec alchemy deploy --config stacks/github.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@effect/tsgo": "0.51.1",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "24.13.6",
    "effect": "4.0.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "2.11.2",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "varlock": "1.23.0",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.1.2"
  },
  "packageManager": "pnpm@11.3.0"
}
