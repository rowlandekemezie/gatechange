{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": ["effect/http/FetchHttpClient"]
      }
    ]
  },
  "include": [
    "*.config.ts",
    "scripts/*.ts",
    "tools/oxlint/**/*.ts",
    ".claude/skills/verify/scripts/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".agent_sources",
    ".agent-sources",
    ".turbo"
  ]
}
