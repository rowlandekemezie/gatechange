# Declared environment for this project. Checked in; no values here.
# Put local values in .env.local (gitignored). Validate with `pnpm env:check`.
# The JobsBackend Worker's keys come from apps/api/.env.schema.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# @import(./apps/api/.env.schema)
# ---

# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Alchemy profile used for deploys. Set it explicitly; credentials stay in the profile.
# @type=string
# @sensitive=false
ALCHEMY_PROFILE=

# Turbo sets this only inside a task.
# @type=string
# @sensitive=false
TURBO_HASH=
