# Declared environment for this project. Checked in; no values here.
# Put local values in .env.local (gitignored). Validate with `pnpm env:check`.
# The JobsBackend Worker's keys come from apps/api/.env.schema.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# @import(./apps/api/.env.schema)
# ---

# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Alchemy profile used for deploys. Set it explicitly; credentials stay in the profile.
# @type=string
# @sensitive=false
ALCHEMY_PROFILE=

# Alchemy credential directory. CI preview uses a disposable private runner directory.
# @type=string
# @sensitive=false
ALCHEMY_HOME=

# Cloudflare credentials for `pnpm self-host` only, as an alternative to ALCHEMY_PROFILE.
# When the account id and a token or key are all set, they override the profile.
# Repository deploys use a profile locally and CI secrets in CI.
# @type=string
# @sensitive=false
CLOUDFLARE_ACCOUNT_ID=

# @type=string
CLOUDFLARE_API_TOKEN=

# @type=string
CLOUDFLARE_API_KEY=

# Preview CI inputs; mapped to the isolated profile and Worker only by its workflow.
# @type=string
PREVIEW_BETTER_AUTH_SECRET=

# @type=string
PREVIEW_STRIPE_TEST_API_KEY=

# PostHog product analytics. Both Workers read these; leave both empty to turn
# analytics off, which is the default on every stage. The project key (phc_...)
# is public by design: the site sends it to browsers. Never put a personal API
# key (phx_...) here; nothing at runtime needs one.
# @type=string
# @sensitive=false
POSTHOG_PROJECT_KEY=

# PostHog Cloud region of the project: us or eu.
# @type=enum(us, eu)
# @sensitive=false
POSTHOG_REGION=

# Turbo sets this only inside a task.
# @type=string
# @sensitive=false
TURBO_HASH=
